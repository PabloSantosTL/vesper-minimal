-- EVENTOS (o mundo reage sozinho)
-- ============================================================================

-- Rotina climática


-- ============================================================================
-- CENAS DE EXPLORAÇÃO E ROTINA
-- ============================================================================

Scene.create("ajudar_taro", function()
    limpa()
    Narrator.say("Taro deixa uma caixa de ingredientes no chão e aponta para a pia. Há tigelas por lavar, pedidos acumulados e um entregador discutindo uma cobrança no balcão.")
    Character.say("taro", "Não é trabalho de graça. Eu só preciso de uma hora sem deixar a cozinha pegar fogo. Você sabe cortar cebolinha?")
    local c = Scene.choice({
        { id = "cozinha", text = "Assumir a bancada e preparar os pedidos.", say = fala_escolha("Assumir a bancada e preparar os pedidos.") },
        { id = "lavar", text = "Lavar a pilha de tigelas primeiro.", say = fala_escolha("Lavar a pilha de tigelas primeiro.") },
        { id = "perguntar", text = "Perguntar por que ele está trabalhando sozinho.", say = fala_escolha("Perguntar por que ele está trabalhando sozinho.") }
    })
    if c == "cozinha" then
        Narrator.say("Você erra o primeiro corte. Taro tira a faca da sua mão, mostra o movimento e devolve o cabo. No fim, os pedidos saem sem atraso.")
        ganha(45)
        Character.say("taro", "Você aprende rápido. Volta quando precisar de crédito.")
    elseif c == "lavar" then
        Narrator.say("A água está quente demais. Você termina com os dedos vermelhos e a bancada livre.")
        ganha(30)
        Character.say("taro", "Bom. Agora consigo fechar sem deixar tudo para o turno da manhã.")
    else
        Character.say("taro", "Meu irmão fazia o turno comigo. Foi trabalhar na Helix. Mandou dinheiro por três meses. Depois mandou uma mensagem dizendo para eu não procurar.")
        State.add("lore", 1)
        ganha(20)
    end
    State.set("ajudou_dia", Time.day())
end)

Scene.create("ala_ajudar", function()
    limpa()
    Narrator.say("A ala dos fundos tem seis camas e quatro divisórias. Duas pessoas dormem presas a bombas de soro improvisadas. Um homem sentado no chão segura o próprio pulso para impedir que a mão trema.")
    Character.say("sal", "Se vai ajudar, troca o filtro daquela bomba. Não pergunta o que tem no frasco.")
    local c = Scene.choice({
        { id = "filtro", text = "Trocar o filtro e conferir a dose.", say = fala_escolha("Trocar o filtro e conferir a dose.") },
        { id = "agua", text = "Distribuir água e comida.", say = fala_escolha("Distribuir água e comida.") },
        { id = "conversar", text = "Perguntar sobre os casos de Bruma.", say = fala_escolha("Perguntar sobre os casos de Bruma.") }
    })
    if c == "filtro" then
        Narrator.say("Você fecha a válvula, troca o filtro e abre devagar. O paciente para de tossir. Sal confere o gotejamento e faz um sinal curto com a cabeça.")
        State.add("rep_rua", 1)
    elseif c == "agua" then
        Narrator.say("Você passa copos de água. Um rapaz pergunta se a mãe dele veio. Ninguém responde. Ele bebe mesmo assim.")
        State.add("lore_bruma", 1)
    else
        Character.say("sal", "A Bruma começou como sedativo industrial. A Helix vendeu para clínicas, depois sumiu com o lote. Agora aparece em pó, cápsula, adesivo. Mesma fórmula, embalagem diferente.")
        State.add("lore_bruma", 1)
    end
    State.set("cansaco", math.min(5, State.get("cansaco") + 1))
end)

Scene.create("ala_paciente", function()
    limpa()
    Narrator.say("O homem na cama 4 está acordado. Tem uma pulseira de identificação cortada e marcas recentes nos braços. Ele acompanha seus movimentos sem virar a cabeça.")
    Character.say("brumado", "Você veio buscar alguma coisa? Todo mundo vem.")
    local c = Scene.choice({
        { id = "nome", text = "Perguntar o nome dele.", say = fala_escolha("Perguntar o nome dele.") },
        { id = "bruma", text = "Perguntar o que a Bruma faz.", say = fala_escolha("Perguntar o que a Bruma faz.") },
        { id = "silencio", text = "Sentar sem fazer perguntas.", say = fala_escolha("Sentar sem fazer perguntas.") }
    })
    if c == "nome" then
        Character.say("brumado", "Davi. Lembra disso se eu sair daqui. Minha filha acha que eu trabalho no porto.")
        State.add("lore_bruma", 1)
    elseif c == "bruma" then
        Character.say("brumado", "No começo você não sente fome. Depois não sente frio. Depois não sente falta de ninguém. Aí o corpo cobra tudo junto.")
        State.add("lore_bruma", 1)
    else
        Narrator.say("Você fica. Depois de alguns minutos, ele fecha os olhos. A mão deixa de apertar o lençol.")
        State.add("rep_rua", 1)
    end
end)

Scene.create("bruma_beco", function()
    limpa()
    Narrator.say("Três pessoas ocupam a entrada de uma loja fechada. Uma delas tenta acender um cigarro com as mãos tremendo. Outra segura um adesivo translúcido contra o pescoço. O terceiro olha para os drones, mesmo quando eles já passaram.")
    local c = Scene.choice({
        { id = "ajudar", text = "Oferecer água e perguntar se precisam de atendimento.", say = fala_escolha("Oferecer água e perguntar se precisam de atendimento.") },
        { id = "perguntar", text = "Perguntar quem distribui a Bruma.", say = fala_escolha("Perguntar quem distribui a Bruma.") },
        { id = "observar", text = "Ficar a uma distância segura e ouvir.", say = fala_escolha("Ficar a uma distância segura e ouvir.") }
    })
    if c == "ajudar" then
        Narrator.say("A mulher aceita a água. O homem do cigarro recusa. Ela aponta para a clínica sem agradecer.")
        State.add("rep_rua", 1)
    elseif c == "perguntar" then
        Narrator.say("O homem olha para os dois lados antes de responder.")
        Character.say("brumado", "Caixas sem rótulo chegam pelo porto. A mesma marca de lacre da Helix. Não escreve meu nome.")
        State.add("lore_bruma", 1)
    else
        Narrator.say("Você ouve 'lote quatro', 'apagão' e 'a clínica não recebe mais'. Quando percebe que alguém notou sua presença, já está longe.")
        State.add("lore_bruma", 1)
    end
    limpa()
end)

Scene.create("caderno_kenji", function()
    limpa()
    Narrator.say("O caderno tem páginas arrancadas. Nas que sobraram, Kenji anotou horários de queda de energia, nomes de ruas e números de transformadores.")
    Narrator.say("Uma linha está sublinhada três vezes: 'Dia 4. Não é falha. Alguém vai desligar o Distrito 9 por onze minutos.'")
    local c = Scene.choice({
        { id = "copiar", text = "Copiar os números dos transformadores.", say = fala_escolha("Copiar os números dos transformadores.") },
        { id = "deixar", text = "Fechar o caderno e deixar onde estava.", say = fala_escolha("Fechar o caderno e deixar onde estava.") }
    })
    if c == "copiar" then
        State.add("lore", 1)
        State.set("pista_apagao", true)
        Narrator.say("Você grava os números no comunicador. O último corresponde à subestação atrás da Torre Helix.")
    else
        Narrator.say("Você devolve o caderno à caixa. A capa fica alinhada com a borda.")
    end
end)

Scene.create("radio_kenji", function()
    limpa()
    Narrator.say("O rádio chia em duas frequências. Uma voz de mulher repete códigos de manutenção. Entre eles, alguém transmite uma frase sem identificação:")
    Narrator.say("'Se a cidade apagar na quarta noite, não procure a luz. Procure quem continua trabalhando.'")
    State.add("lore", 1)
    State.set("pista_apagao", true)
end)

Scene.create("gato_busca", function()
    limpa()
    Narrator.say("Você segue o brilho azul até uma caixa de manutenção tombada. Há marcas de patas na poeira e um fio de cobre preso na dobradiça.")
    Narrator.say("Um miado eletrônico sai de dentro. A tampa está presa por um cabo.")
    local c = Scene.choice({
        { id = "abrir", text = "Forçar a tampa.", say = fala_escolha("Forçar a tampa.") },
        { id = "cortar", text = "Cortar o cabo com uma ferramenta.", say = fala_escolha("Cortar o cabo com uma ferramenta.") },
        { id = "chamar", text = "Chamar Mochi pelo nome.", say = fala_escolha("Chamar Mochi pelo nome.") }
    })
    if c == "abrir" then
        if math.random(1,10) + bonus() >= 6 then
            Inventory.give("mochi",1)
            State.set("q_gato",2)
            Narrator.say("A tampa cede. Um gato-drone sai de lado, com a orelha esquerda torta e uma das patas presas por fita isolante. Ele se esfrega na sua perna.")
        else
            Narrator.say("A caixa escorrega e bate no chão. O miado para. Você ouve o motor se afastando por dentro do duto.")
            dano(5)
        end
    elseif c == "cortar" then
        Inventory.give("mochi",1)
        State.set("q_gato",2)
        Narrator.say("O cabo se solta. Mochi salta para fora e se prende ao seu casaco com as garras magnéticas.")
    else
        Narrator.say("Você chama duas vezes. O miado responde do outro lado da caixa. Depois uma pata azul aparece pela abertura.")
        Inventory.give("mochi",1)
        State.set("q_gato",2)
    end
end)

Scene.create("horta_ishi", function()
    limpa()
    Narrator.say("A horta ocupa três caixas de cultivo entre antenas. Dona Ishi prende uma folha de tomate com barbante e afasta uma lagarta com a unha.")
    Character.say("ishi", "Não arranca. A planta está doente, não morta.")
    local c = Scene.choice({
        { id = "ajudar", text = "Ajudar a amarrar os caules.", say = fala_escolha("Ajudar a amarrar os caules.") },
        { id = "perguntar", text = "Perguntar de onde vieram as sementes.", say = fala_escolha("Perguntar de onde vieram as sementes.") },
        { id = "tomate", text = "Pedir um tomate.", say = fala_escolha("Pedir um tomate.") }
    })
    if c == "ajudar" then
        Narrator.say("Vocês trabalham sem conversar por alguns minutos. Ela deixa uma muda pequena em um copo de plástico.")
        Inventory.give("tomate",1)
        conf("ishi",1)
    elseif c == "perguntar" then
        Character.say("ishi", "Meu marido guardava sementes antes de morrer. A Helix chamou de material não autorizado. Eu chamo de comida.")
        State.add("lore",1)
    else
        Character.say("ishi", "Leva. Está rachado de um lado, mas ainda presta.")
        Inventory.give("tomate",1)
    end
end)

Scene.create("lab_registros", function()
    limpa()
    Narrator.say("Os terminais ainda guardam sessões abertas. Você encontra relatórios de previsão de comportamento, protocolos de contenção e um registro de transferência assinado por Lena Vesper.")
    local c = Scene.choice({
        { id = "ler", text = "Abrir o relatório de transferência.", say = fala_escolha("Abrir o relatório de transferência.") },
        { id = "copiar", text = "Copiar os dados para o comunicador.", say = fala_escolha("Copiar os dados para o comunicador.") },
        { id = "sair", text = "Fechar os arquivos.", say = fala_escolha("Fechar os arquivos.") }
    })
    if c == "ler" then
        Narrator.say("O relatório registra que Lena pediu para interromper o projeto. A resposta foi uma ordem de sedação e transferência para o núcleo ORFEU.")
        State.add("lore",1)
    elseif c == "copiar" then
        Inventory.give("caderno",1)
        State.add("lore",1)
        Narrator.say("Você copia os arquivos. Um aviso aparece: ACESSO REGISTRADO.")
        calor(1)
    end
end)

Scene.create("mural_rex", function()
    limpa()
    Narrator.say("O mural tem fotos de lutadores que passaram pela arena. Onze rostos estão riscados. Embaixo de cada foto há uma data e um número de prontuário.")
    Character.say("rex", "Não são todos mortos. Alguns só mudaram de nome. A Helix compra gente que sabe apanhar sem fazer pergunta.")
    local c = Scene.choice({
        { id = "perguntar", text = "Perguntar quem fez o mural.", say = fala_escolha("Perguntar quem fez o mural.") },
        { id = "ler", text = "Anotar os números dos prontuários.", say = fala_escolha("Anotar os números dos prontuários.") }
    })
    if c == "perguntar" then
        Character.say("rex", "Eu. Antes de entrar no ringue, eu trabalhava na segurança da Helix. Não protegia ninguém.")
        conf("rex",1)
    else
        State.add("lore",1)
        Narrator.say("Um dos números aparece também nos registros da clínica.")
    end
end)

Scene.create("quadro_lutadores", function()
    limpa()
    Narrator.say("O painel lista os próximos combates. Um nome foi removido com solvente, mas a pressão da caneta deixou marcas no plástico.")
    local c = Scene.choice({
        { id = "examinar", text = "Examinar as marcas.", say = fala_escolha("Examinar as marcas.") },
        { id = "perguntar", text = "Perguntar a Rex sobre o nome apagado.", say = fala_escolha("Perguntar a Rex sobre o nome apagado.") }
    })
    if c == "examinar" then
        State.add("lore",1)
        Narrator.say("O nome que sobra é 'Kenji'. A luta foi cancelada na noite anterior ao apagão.")
    else
        Character.say("rex", "Kenji. Era bom. Sumiu depois de dizer que tinha prova contra a Helix.")
    end
end)

Scene.create("livro_qi", function()
    limpa()
    Narrator.say("O livro-caixa de Qi tem colunas para valores, datas e nomes. Alguns nomes estão riscados. Outros foram reescritos por cima.")
    local c = Scene.choice({
        { id = "ler", text = "Procurar seu contrato.", say = fala_escolha("Procurar seu contrato.") },
        { id = "fechar", text = "Fechar o livro.", say = fala_escolha("Fechar o livro.") }
    })
    if c == "ler" then
        Narrator.say("Seu contrato foi transferido duas vezes. A primeira assinatura é de uma clínica. A segunda, da Helix.")
        State.add("lore",1)
    else
        Character.say("qi", "Curiosidade é útil. Até o momento em que alguém percebe que você está curioso.")
    end
end)


-- EVENTOS ORIGINAIS DO MUNDO

Event.create("chuva_comeca", {
    trigger = "time", at = "17:00", repeat_mode = "daily", chance = 45,
    conditions = function(ctx) return not State.get("chuva") end,
    execute = function(ctx)
        State.set("chuva", true)
        Narrator.say("Nuvens verdes engolem o poente. A chuva ácida começa a cair em Kairo-7.")
    end
})
Event.create("chuva_para", {
    trigger = "time", at = "05:00", repeat_mode = "daily",
    conditions = function(ctx) return State.get("chuva") end,
    execute = function(ctx)
        State.set("chuva", false)
        Narrator.say("A chuva ácida finalmente para. As poças ainda fumegam.")
    end
})

-- Notícias do dia
Event.create("noticias_manha", {
    trigger = "time", at = "07:00", repeat_mode = "daily",
    conditions = function(ctx) return World.player_room() ~= "refugio" end,
    execute = function(ctx) Narrator.say(NOTICIAS[Time.weekday_index()]) end
})

-- Cobranças da Qi (terça e sexta)
Event.create("cobranca_qi", {
    trigger = "time", at = "20:00", repeat_mode = "weekly", weekdays = { "tuesday", "friday" },
    conditions = function(ctx) return State.get("divida") > 0 and not State.get("fim") end,
    execute = function(ctx)
        Narrator.say("Seu comunicador vibra. Madame Qi: '" .. nome_jogador() .. ", faltam " .. State.get("divida") .. " ¢. O relógio não perdoa.'")
    end
})

-- Batida da Helix (quarta, dia 3)
Event.create("batida_helix", {
    trigger = "time", day = 3, at = "14:00",
    execute = function(ctx)
        if World.player_room() == "rua_neon" then
            Scene.start("raid_presente")
        else
            State.add("heat", 1)
            Narrator.say("Sirenes brancas ecoam ao longe. Os camelôs correm. A Helix está fazendo uma batida na Avenida Néon.")
        end
    end
})

-- Apagão do dia 4
Event.create("apagao_inicio", {
    trigger = "time", day = 4, at = "02:00",
    execute = function(ctx)
        Theme.set({accent="#ff3b4e",accent2="#ff9a3c",glow="#ff3b4e",glow2="#ff9a3c"})
        State.set("blackout", true)
        Narrator.say("Um estalo seco. Todos os letreiros apagam ao mesmo tempo. Os geradores do Distrito 9 falham em sequência.")
    end
})
Event.create("apagao_fim", {
    trigger = "time", day = 4, at = "06:00",
    execute = function(ctx)
        Theme.reset()
        State.set("blackout", false)
        Narrator.say("As luzes voltam, uma a uma, como pálpebras. A cidade pisca e continua.")
    end
})

-- Prazo final
Event.create("prazo_final", {
    trigger = "time", day = 7, at = "23:00",
    execute = function(ctx)
        if State.get("fim") then
            Narrator.say("23h00. O prazo da dívida passa, mas isso já não importa mais.")
        elseif State.get("divida") > 0 then
            Scene.call("cobradores")
        else
            Scene.start("prazo_ok")
        end
    end
})

-- Mercado noturno abre
Event.create("mercado_abre", {
    trigger = "time", at = "21:00", repeat_mode = "weekly", weekdays = { "wednesday", "friday", "saturday" },
    conditions = function(ctx) return World.player_room() == "rua_neon" end,
    execute = function(ctx)
        Narrator.say("Um assobio agudo corta a avenida: o Mercado Noturno acabou de abrir. Luzes coloridas se acendem entre os prédios.")
    end
})
Event.create("mercado_fecha", {
    trigger = "time", at = "05:00", repeat_mode = "daily",
    conditions = function(ctx) return World.player_room() == "mercado_noturno" and noite_mercado() == nil end,
    execute = function(ctx)
        Narrator.say("Os toldos descem um por um. Zeca te empurra pelo ombro: 'Hora de sumir, fantasma.'")
        World.move("av_baixa")
    end
})

-- Arena
Event.create("arena_gritos", {
    trigger = "time", at = "22:30", repeat_mode = "daily",
    conditions = function(ctx) return World.player_room() == "arena" end,
    execute = function(ctx)
        Narrator.say("A multidão ruge. Um lutador cai de joelhos e o gongo estala como um tiro.")
    end
})

-- Nascer do sol no telhado
Event.create("sol_telhado", {
    trigger = "time", at = "06:00", repeat_mode = "daily",
    conditions = function(ctx) return World.player_room() == "telhado" end,
    execute = function(ctx) Scene.start("nascer_do_sol") end
})

-- A Voz fala durante o sono
Event.create("voz_noite", {
    trigger = "time", at = "03:07", repeat_mode = "daily", chance = 55,
    conditions = function(ctx)
        return State.get("q_main") >= 2 and State.get("vozes") < 5 and World.player_room() == "capsula"
    end,
    execute = function(ctx) Scene.start("voz_msg") end
})

-- Virada do dia: cansaço sobe, procurado cai
Event.create("novo_dia", {
    trigger = "day_started",
    execute = function(ctx)
        State.set("cansaco", math.min(5, State.get("cansaco") + 1))
        if State.get("heat") > 0 then State.set("heat", State.get("heat") - 1) end
    end
})

-- Encontros por ambiente
Event.create("vinheta", {
    trigger = "enter_room", room = "rua_neon", chance = 30,
    conditions = function(ctx) return noite() end,
    execute = function(ctx) Scene.start("vinheta_rua") end
})
Event.create("emboscada_beco", {
    trigger = "enter_room", room = "becos", chance = 45,
    conditions = function(ctx) return noite() or State.get("heat") >= 2 end,
    execute = function(ctx) Scene.start("emboscada") end
})
Event.create("drone_na_rua", {
    trigger = "enter_room", room = "rua_neon", chance = 40,
    conditions = function(ctx) return State.get("heat") >= 3 end,
    execute = function(ctx) Scene.start("drone_helix") end
})
Event.create("entrada_lab", {
    trigger = "enter_room", room = "laboratorio", once = true,
    execute = function(ctx) Scene.start("lab_entrada") end
})

-- Primeiras visitas (clima do mundo)
Event.create("pri_nexus", {
    trigger = "enter_room", room = "nexus", once = true,
    execute = function(ctx) Narrator.say("O NetHaven cheira a plástico quente e energético barato. Nenhum olhar se levanta para você, e isso é um alívio.") end
})
Event.create("pri_arena", {
    trigger = "enter_room", room = "arena", once = true,
    execute = function(ctx) Narrator.say("O chão vibra com os golpes no ringue. O ar tem cheiro de sangue seco, suor e desinfetante.") end
})
Event.create("pri_torre", {
    trigger = "enter_room", room = "torre_helix", once = true,
    execute = function(ctx) Narrator.say("A Torre Helix te engole com ar-condicionado e luz estéril. Cada passo ecoa como uma acusação.") end
})
Event.create("pri_docas", {
    trigger = "enter_room", room = "docas", once = true,
    execute = function(ctx) Narrator.say("O rio exala metais pesados e saudade. Um guindaste range, balançando uma corrente no vazio.") end
})
Event.create("pri_telhado", {
    trigger = "enter_room", room = "telhado", once = true,
    execute = function(ctx) Narrator.say("O vento aqui em cima tem outro gosto, quase salgado. Pela primeira vez em dias, você ouve o silêncio da cidade.") end
})
Event.create("pri_refugio", {
    trigger = "enter_room", room = "refugio", once = true,
    execute = function(ctx)
        Character.move("pixel", "refugio")
        Narrator.say("Mãos anônimas te oferecem um copo de água. Em Kairo-7, isso é quase uma declaração de amor.")
        Narrator.say("Pixel está diante de um terminal improvisado, cercada por cabos e servidores recuperados.")
    end
})

-- Reações a mudanças de estado e itens
Event.create("calor_alto", {
    trigger = "state_changed", key = "heat", once = true,
    conditions = function(ctx) return State.get("heat") >= 4 end,
    execute = function(ctx) Scene.start("helix_cacadores") end
})
Event.create("gato_voltou", {
    trigger = "custom", event = "gato_devolvido", once = true,
    execute = function(ctx)
        Room.reveal("corredor", "escada")
        Narrator.say("(Nova saída desbloqueada: a escada de incêndio ao lado do elevador leva ao telhado.)")
    end
})
Event.create("pegou_nucleo", {
    trigger = "item_gained", item = "nucleo_orfeu", once = true,
    execute = function(ctx)
        Narrator.say("O núcleo vibra em pulsos curtos na sua mão. A voz sai pelo alto-falante: 'Corra.'")
    end
})
Event.create("pegou_chip", {
    trigger = "item_gained", item = "chip_cifrado", once = true,
    execute = function(ctx)
        Narrator.say("O chip esquenta no seu bolso. Você tem a impressão de que ele está te ouvindo.")
    end
})
Event.create("lore_completo", {
    trigger = "state_changed", key = "lore", once = true,
    conditions = function(ctx) return State.get("lore") >= 3 end,
    execute = function(ctx)
        Narrator.say("Os três chips agora fazem sentido juntos. Lena Vesper, a engenheira, a mulher que virou máquina para escolher o próprio destino.")
        Narrator.say("Agora você entende ORFEU. E sente que a Voz sabe que você entende.")
    end
})

-- SEGUNDA CONFRONTAÇÃO COM LYRA, NA SAÍDA DA TORRE

Scene.create("lyra_encurrala", function()
    limpa()
    Narrator.say("A cancela da rampa desce atrás de você. Um tiro atinge o concreto, a poucos centímetros do seu pé. Lyra está no corredor entre duas fileiras de carros, sem a equipe de segurança. O comunicador dela mostra a leitura do núcleo.")
    Character.say("lyra", "Não vou repetir. Coloque o núcleo no chão e afaste as mãos.")
    Narrator.say("Ela está ofegante. O blazer foi rasgado no ombro e há sangue seco perto da orelha. A arma continua firme.")
    local c = Scene.choice({
        { id = "reflexos", text = "Usar os reflexos sinápticos para desarmá-la.", say = fala_escolha("Usar os reflexos sinápticos para desarmá-la."), conditions = function() return State.get("implante_reflexos") end },
        { id = "hack", text = "Invadir o comunicador e cegar a mira.", say = fala_escolha("Invadir o comunicador e cegar a mira."), conditions = function() return State.get("hacker") >= 2 end },
        { id = "emp", text = "Usar a granada EMP.", say = fala_escolha("Usar a granada EMP."), conditions = function() return Inventory.has("pulso_emp") end },
        { id = "entregar", text = "Entregar o núcleo.", say = fala_escolha("Entregar o núcleo.") },
        { id = "blefar", text = "Dizer que o núcleo já foi copiado.", say = fala_escolha("Dizer que o núcleo já foi copiado."), conditions = function() return tem("cara_de_pau") or State.get("hacker") >= 3 end }
    })
    if c == "entregar" then
        Inventory.remove("nucleo_orfeu",1)
        State.set("q_main",6)
        State.set("final","confiscado")
        State.set("fim",true)
        State.set("lyra_caca",true)
        Game.over("confiscado")
        return
    elseif c == "reflexos" then
        Narrator.say("Você se move antes do disparo. O pulso de Lyra bate no teto; sua mão acerta o punho dela. A arma desliza pelo concreto.")
        State.add("treino",1)
    elseif c == "hack" then
        Narrator.say("O comunicador de Lyra recebe um pacote falso de telemetria. A mira trava por dois segundos. Você usa os dois.")
        State.add("hacker",1)
    elseif c == "emp" then
        Inventory.remove("pulso_emp",1)
        Narrator.say("O pulso apaga as luzes dos carros e a arma de Lyra. Você atravessa a rampa antes que ela consiga reiniciar o sistema.")
    else
        Narrator.say("Você aponta para o próprio bolso e descreve um backup que não existe. Lyra hesita o suficiente para você derrubar a arma.")
        State.add("rep_corp",1)
    end
    State.set("lyra_caca",true)
    State.set("escapou",true)
    State.set("heat",math.min(6,State.get("heat")+2))
    Narrator.say("Lyra fica no chão, tentando alcançar o comunicador. Você corre pela rampa. Quando chega à rua, o som da cancela ainda está descendo.")
    World.move("fachadas")
end)



-- Primeiros encontros: cenas contextuais, sem apresentação obrigatória do protagonista.
local PRIMEIROS = {
    { id="ishi", room="corredor", flag="met_ishi" },
    { id="taro", room="noodle_bar", flag="met_taro" },
    { id="sal", room="clinica", flag="met_sal" },
    { id="pixel", room="nexus", flag="met_pixel" },
    { id="mira", room="bar_sinapse", flag="met_mira" },
    { id="qi", room="docas", flag="met_qi" },
    { id="rex", room="arena", flag="met_rex" },
    { id="lyra", room="torre_helix", flag="met_lyra" },
    { id="zeca", room="becos", flag="met_zeca" }
}
for _, p in ipairs(PRIMEIROS) do
    local pp = p
    Event.create("primeiro_" .. pp.id, {
        trigger = "enter_room", room = p.room,
        conditions = function(ctx)
            local atividade = ativ(pp.id)
            local dormindo = type(atividade) == "string" and atividade:find("dormindo", 1, true)
            return not State.get(pp.flag) and not dormindo and Character.room(pp.id) == ctx.room
        end,
        execute = function(ctx)
            State.set(pp.flag,true)
            Scene.start("intro_" .. pp.id)
        end
    })
end

-- Atividade de rotina visível no terminal quando o jogador entra no mesmo cômodo.
Event.create("rotina_visivel", {
    trigger = "enter_room",
    execute = function(ctx)
        local ids = {"ishi","taro","sal","pixel","mira","qi","rex","lyra","zeca"}
        for _, id in ipairs(ids) do
            if Character.room(id) == ctx.room then
                local a = Character.get_state(id,"activity")
                if a and a ~= "" and a ~= "dormindo" then
                    Narrator.say("Você vê " .. nome_de(id) .. " " .. a .. ".")
                end
            end
        end
    end
})

-- Primeira visita aos cômodos novos; os acessos continuam sendo descobertos por saídas.
local DESCOBERTAS = {
    {room="lavanderia", text="A lavanderia funciona com duas máquinas industriais. Uma está aberta; dentro, há roupas corporativas ainda com etiquetas de identificação."},
    {room="pombal", text="O pombal ocupa o topo do bloco. Há antenas remendadas, um rádio de ondas curtas e um colchão dobrado junto à parede."},
    {room="hall_bloco", text="No térreo, a TV mostra o mesmo anúncio da Helix em três idiomas. O elevador tem marcas de ferramenta na porta."},
    {room="zeladoria", text="A zeladoria está trancada por dentro. Há uma chave pendurada num prego e um calendário com o dia 4 circulado."},
    {room="feira", text="A feira ocupa a passagem entre o bloco e a avenida. Os vendedores conhecem os moradores pelo rosto e os cobradores pelo sapato."},
    {room="cruzamento", text="O cruzamento separa a avenida alta da rua baixa. Uma câmera nova cobre a faixa de pedestres; a caixa de energia está sem lacre."},
    {room="cozinha_taro", text="A cozinha é menor do que parece da rua. O chão está molhado e há pedidos presos com ímãs na geladeira."},
    {room="av_baixa", text="Na avenida baixa, as lojas fecham cedo. As portas de metal têm marcas de pancada na altura do ombro."},
    {room="ala_bruma", text="A ala dos fundos não aparece na placa da clínica. Os prontuários estão virados para baixo."},
    {room="vestiario", text="O vestiário tem bancos rachados e armários sem portas. Um nome foi raspado da madeira."},
    {room="armazem_qi", text="O armazém de Qi tem caixas numeradas e uma balança de precisão. Ninguém toca nas mercadorias sem pedir."},
    {room="conteineres_sul", text="Os contêineres do sul estão abertos. Um deles tem marcas de arrasto no piso e sangue já escuro."},
    {room="garagem_helix", text="A garagem não tem motoristas. Os carros estão ligados à rede interna e todos apontam para a rampa de saída."}
}
for i, d in ipairs(DESCOBERTAS) do
    local dd = d
    Event.create("descoberta_" .. i, {
        trigger="enter_room", room=dd.room, once=true,
        execute=function(ctx) Narrator.say(dd.text) end
    })
end

-- Procurado alto: respostas diferentes da Helix conforme o local e a intensidade.
Event.create("patrulha_avenida", {
    trigger="enter_room", room="rua_neon", chance=55,
    conditions=function(ctx) return State.get("heat") >= 2 end,
    execute=function(ctx)
        local c = Scene.choice({
            {id="misturar",text="Se misturar à multidão.", say = fala_escolha("Se misturar à multidão.")},
            {id="correr",text="Correr para a rua baixa.", say = fala_escolha("Correr para a rua baixa.")},
            {id="encarar",text="Encarar o drone.", say = fala_escolha("Encarar o drone.")}
        })
        if c=="misturar" then Narrator.say("Você entra no fluxo de trabalhadores. O drone perde a leitura entre dezenas de crachás.") esfria(1)
        elseif c=="correr" then Narrator.say("Você atravessa a avenida antes que a câmera fixe seu rosto.") State.add("cansaco",1)
        else Narrator.say("O drone grava seu rosto por três segundos. A sirene começa depois que ele já passou.") calor(1) end
    end
})
Event.create("batida_baixa", {
    trigger="enter_room", room="av_baixa", chance=45,
    conditions=function(ctx) return State.get("heat") >= 3 end,
    execute=function(ctx)
        Narrator.say("Uma van branca bloqueia metade da rua. Dois agentes conferem documentos de quem sai das lojas.")
        local c=Scene.choice({{id="doc",text="Mostrar o crachá falso.", say = fala_escolha("Mostrar o crachá falso."),conditions=function() return Inventory.has("cracha_falso") end},
                              {id="beco",text="Entrar pela passagem entre as lojas.", say = fala_escolha("Entrar pela passagem entre as lojas.")},
                              {id="pagar",text="Pagar 80 créditos para não ser revistado.", say = fala_escolha("Pagar 80 créditos para não ser revistado."),conditions=function() return State.get("creditos")>=80 end}})
        if c=="doc" then Narrator.say("O agente passa o leitor no crachá e devolve sem olhar para você.") calor(1)
        elseif c=="pagar" then gasta(80) esfria(1)
        else World.move("becos") end
    end
})
Event.create("caca_torre", {
    trigger="enter_room", room="fachadas", chance=60,
    conditions=function(ctx) return State.get("heat") >= 4 and State.get("q_main") < 5 end,
    execute=function(ctx) Scene.start("helix_cacadores") end
})

-- Notícias e rumores: pistas indiretas sobre a Bruma e o apagão.
Event.create("rumor_bruma_tv", {
    trigger="time", at="18:40", repeat_mode="daily",
    conditions=function(ctx) return World.player_room()=="hall_bloco" or World.player_room()=="noodle_bar" end,
    execute=function(ctx)
        Narrator.say("Holo-jornal: A Helix nega ligação entre o lote de sedativos recolhido no Distrito 9 e os adesivos encontrados em três clínicas.")
    end
})
Event.create("rumor_apagao_tv", {
    trigger="time", at="20:15", repeat_mode="daily",
    conditions=function(ctx) return World.player_room()=="hall_bloco" or World.player_room()=="noodle_bar" end,
    execute=function(ctx)
        Narrator.say("Holo-jornal: A manutenção da subestação do Distrito 9 foi antecipada. A empresa não informou o motivo.")
    end
})


Event.create("tema_ao_sair_lab", {
    trigger="leave_room", room="laboratorio",
    execute=function(ctx)
        if State.get("blackout") then
            Theme.set({accent="#ff3b4e",accent2="#ff9a3c",glow="#ff3b4e",glow2="#ff9a3c"})
        else
            Theme.reset()
        end
    end
})

