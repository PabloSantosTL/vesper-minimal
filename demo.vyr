-- ============================================================================
-- CENAS: ABERTURA E UTILITÁRIOS
-- ============================================================================

Scene.create("inicio", function()
    limpa()
    State.set("chuva", true)
    Inventory.give("caderno", 1)
    Narrator.say("KAIRO-7, DISTRITO 9. SEGUNDA-FEIRA, 23h10.")
    Narrator.say("{player.nome}, cápsula 14-C. A chuva ácida bate no acrílico da janela e deixa riscos verdes. Você está sentado na beira do colchão, com os sapatos ainda nos pés e o casaco molhado nas costas.")
    Narrator.say("O comunicador toca na prateleira de cima. Duas notas, uma grave e uma doce. Você sabe quem é pelo toque.")
    Scene.wait()
    Character.say("qi", "Boa noite, " .. g("querido", "querida", "meu bem") .. ". A conta é simples: três mil créditos até domingo, às vinte e três horas.")
    local m = Player.get("motivo")
    if m == "mae" then Character.say("qi", "Sua mãe teve o melhor tratamento que o dinheiro compra. Eu mesma escolhi o médico.")
    elseif m == "aposta" then Character.say("qi", "Eu avisei que o cavalo mancava. Você achou que eu falava de cavalo.")
    elseif m == "implante" then Character.say("qi", "O implante ainda funciona? Foi o que eu pensei. Duas semanas, no máximo.")
    else Character.say("qi", "Seu irmão era uma pessoa educada. Pena que ele esqueceu de levar a dívida com ele.") end
    local c = Scene.choice({
        { id = "prometer", text = "Prometer que vai pagar.", say = fala_escolha("Prometer que vai pagar.") },
        { id = "negociar", text = "Perguntar se dá para negociar o prazo.", say = fala_escolha("Perguntar se dá para negociar o prazo.") },
        { id = "desligar", text = "Desligar sem responder.", say = fala_escolha("Desligar sem responder.") }
    })
    if c == "prometer" then
        Character.say("qi", "Promessa não rende juros, mas rende simpatia. Eu aceito simpatia.")
    elseif c == "negociar" then
        Character.say("qi", "Tudo se negocia. Menos o prazo. Esse eu não fiz. Quem fez foi a aritmética.")
    else
        Narrator.say("A tela volta a ficar preta. Três segundos depois, o comunicador vibra de novo com uma mensagem de texto de Qi: 'Eu espero.'")
    end
    Character.say("qi", "Boa noite. Durma, se conseguir.")
    Scene.wait()
    Narrator.say("Outra mensagem, sem remetente: 'Bar Sinapse. Hoje à noite. Tenho um trabalho que paga bem. — M.'")
    Narrator.say("Você tem 350 créditos no bolso, sete dias e um painel de LED que pisca em vermelho porque a porra da rede da cápsula caiu de novo.")
    local d = Scene.choice({
        { id = "bar", text = "Ir ao Bar Sinapse agora.", say = fala_escolha("Ir ao Bar Sinapse agora.") },
        { id = "dormir", text = "Dormir e ver o que o amanhã traz.", say = fala_escolha("Dormir e ver o que o amanhã traz.") },
        { id = "janela", text = "Ficar olhando a cidade pela janela.", say = fala_escolha("Ficar olhando a cidade pela janela.") }
    })
    if d == "bar" then
        Narrator.say("Você enfia o casaco ainda úmido, confere a carteira e o comunicador e puxa a porta da cápsula.")
    elseif d == "dormir" then
        Narrator.say("Você deita de lado, com os joelhos dobrados. O LED verde pisca na parede e marca os segundos no escuro. Você não dorme, mas ninguém precisa saber.")
    else
        Narrator.say("No prédio da frente, uma janela acesa mostra alguém passando roupa. Mais acima, o topo da Torre Helix tem as luzes de aviso piscando em vermelho. Nenhuma das duas coisas ajuda a pagar a dívida.")
    end
    Game.save("Cápsula 14-C, segunda à noite")
end)

Scene.create("ajuda", function()
    limpa()
    Narrator.say("MANUAL DO COMUNICADOR (versão gratuita, com anúncios)")
    Narrator.say("1) O relógio não para. Andar, dormir, conversar e trabalhar gastam minutos. A cidade continua se mexendo mesmo quando você não olha.")
    Narrator.say("2) Quem tem rotina tem horário. Se alguém não estiver onde você esperava, tente outra hora ou outro dia.")
    Narrator.say("3) Comunicador não sabe tudo. Gente sabe mais. Quem pergunta, escuta. Quem escuta, volta com algo.")
    Narrator.say("4) O inventário guarda o que você carrega. O caderno guarda o que você decidiu lembrar.")
    Narrator.say("(Anúncio: Calmante Cívico. Um comprimido, uma noite tranquila. Serenia Pharma, empresa do grupo Helix.)")
end)

Scene.create("pagar_qi", function()
    limpa()
    Narrator.say("Seu saldo: " .. State.get("creditos") .. " ¢. Dívida: " .. State.get("divida") .. " ¢.")
    local c = Scene.choice({
        { id = "p50",  text = "Pagar 50 ¢.", say = fala_escolha("Pagar 50 ¢."),  conditions = function() return State.get("creditos") >= 50 and State.get("divida") > 0 end },
        { id = "p200", text = "Pagar 200 ¢.", say = fala_escolha("Pagar 200 ¢."), conditions = function() return State.get("creditos") >= 200 and State.get("divida") > 0 end },
        { id = "p500", text = "Pagar 500 ¢.", say = fala_escolha("Pagar 500 ¢."), conditions = function() return State.get("creditos") >= 500 and State.get("divida") > 0 end },
        { id = "tudo", text = "Pagar tudo o que tenho.", say = fala_escolha("Pagar tudo o que tenho."), conditions = function() return State.get("creditos") > 0 and State.get("divida") > 0 end },
        { id = "nada", text = "Fechar o app.", say = fala_escolha("Fechar o app.") }
    })
    if c == "p50" then paga(50)
    elseif c == "p200" then paga(200)
    elseif c == "p500" then paga(500)
    elseif c == "tudo" then paga(State.get("creditos")) end
    if State.get("divida") <= 0 then
        Narrator.say("O app pisca: DÍVIDA QUITADA. Você fica olhando a palavra por um tempo sem pensar em nada.")
    end
end)

Scene.create("apagao_medico", function()
    limpa()
    Narrator.say("Sua visão escurece pelas bordas, como uma cortina fechando. O chão chega antes do resto do corpo.")
    Scene.delay(300)
    Narrator.say("Você acorda deitado no concreto, com gosto de ferro na boca. A carteira está mais leve e as costelas doem de um lado só. Alguém te revistou com calma, sem pressa nenhuma.")
    local perda = math.min(State.get("creditos"), 100)
    State.subtract("creditos", perda)
    State.set("saude", 35)
    Narrator.say("(Perdeu " .. perda .. " ¢. Saúde restaurada a 35.)")
end)

