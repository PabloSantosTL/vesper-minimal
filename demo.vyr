-- ---------- Bloco 14 ----------

Room.create("capsula", {
    title = "Sua cápsula (Bloco 14-C)",
    description = function(ctx)
        local s = "Dois metros por um e meio, com o teto a oitenta centímetros do seu rosto. Dá pra encostar numa parede e na outra ao mesmo tempo. Tem um colchão fino, uma única tomada e um painel de LED na parede, que pisca vermelho quando a rede cai."
        if Time.is_night() then s = s .. " Pela janela de acrílico você vê a parede do prédio da frente e, entre dois blocos, um pedaço da Torre Helix." end
        if State.get("chuva") then s = s .. " A chuva ácida escorre no vidro e deixa riscos verdes." end
        if State.get("heat") >= 4 then s = s .. " Tem uma câmera nova parafusada no poste, bem na frente da sua janela. Ontem ela não estava lá." end
        return s
    end,
    exits = { { id = "porta", to = "corredor", label = "Sair para o corredor", duration = 1 } },
    actions = {
        { id = "dormir", label = "Dormir até recuperar (8 h)", duration = 480, save = true,
          execute = function(ctx)
              limpa()
              State.set("cansaco", 0)
              curar(25)
              Narrator.say("O alarme do comunicador grita no volume máximo. Você acorda com a nuca suada e a garganta seca. " .. Time.weekday_name() .. ", dia " .. Time.day() .. ". (Cansaço zerado, +25 saúde)")
          end },
        { id = "cochilar", label = "Cochilar (2 h)", duration = 120,
          execute = function(ctx)
              limpa()
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
              curar(5)
              Narrator.say("Você dorme mal. Duas vezes alguém passa correndo pelo corredor e te acorda. (+5 saúde, menos cansaço)")
          end },
        { id = "pagar", label = "Transferir créditos para Madame Qi", duration = 2,
          conditions = function(ctx) return State.get("divida") > 0 and State.get("creditos") >= 50 end,
          scene = "pagar_qi" },
        { id = "janela", label = "Olhar pela janela (10 min)", duration = 10, scene = "janela_vista" },
        { id = "manual", label = "Abrir o manual do comunicador", duration = 0, scene = "ajuda" }
    }
})

Room.create("corredor", {
    title = "Corredor do Bloco 14",
    description = function(ctx)
        local s = "Um corredor estreito, com uma lâmpada de LED a cada três portas, e metade delas queimada. Tem fios soltos no teto e cheiro de ferro e de solda. As cápsulas ficam empilhadas em dois andares, com uma escadinha de metal para chegar nas de cima. Numa das portas tem um adesivo: 'Não perturbe'."
        if State.get("q_gato") < 3 then s = s .. " Perto da porta 14-A tem um cartaz de gato desaparecido, preso na parede com fita isolante." end
        return s
    end,
    exits = {
        { id = "capsula", to = "capsula", label = "Entrar na sua cápsula", duration = 1 },
        { id = "elevador", to = "hall_bloco", label = "Descer pelo elevador", duration = 3 },
        { id = "lavanderia", to = "lavanderia", label = "Ir à lavanderia coletiva", duration = 1 },
        { id = "escada", to = "telhado", label = "Subir a escada de incêndio até o telhado", duration = 4, hidden = true }
    },
    actions = {
        falar("ishi"),
        { id = "escutar", label = "Parar e escutar as portas (10 min)", duration = 10, scene = "escuta_portas" }
    }
})

Room.create("lavanderia", {
    title = "Lavanderia coletiva",
    description = "Seis máquinas de lavar de moeda, duas com a porta lacrada com fita. Tem um banco de plástico, um varal de ferro com roupas que ninguém veio buscar e um ventilador no teto que gira sem mexer o ar. Cheira a sabão barato e a mofo.",
    exits = { { id = "corredor", to = "corredor", label = "Voltar ao corredor", duration = 1 } },
    actions = {
        { id = "papo", label = "Esperar uma máquina e puxar assunto (25 min)", duration = 25, scene = "papo_lavanderia" },
        { id = "lavar", label = "Lavar o casaco (40 min)", duration = 40, conditions = function() return State.get("creditos") >= 5 end,
          execute = function(ctx)
              limpa()
              State.subtract("creditos", 5)
              Narrator.say("Você põe cinco créditos, tira o casaco e espera só de camiseta. A água que sai do tambor é cinza e depois fica marrom. (-5 ¢)")
              if State.get("chuva") then Narrator.say("Das mangas do casaco cai uma crosta verde, o resto da chuva ácida. O tecido está mais fino do que ontem.") end
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
          end }
    }
})

Room.create("telhado", {
    title = "Telhado do Bloco 14",
    description = function(ctx)
        local s
        if Time.is_night() then
            s = "Antenas, caixas d'água e parabólicas apontadas pra lugar nenhum. De lá dá pra ver a Torre Helix, e embaixo dela o Distrito 9 inteiro, com os prédios colados uns nos outros."
        else
            s = "Antenas, caixas d'água e roupas penduradas em varais de cabo. Vista de cima, a cidade parece menor e mais suja."
        end
        if State.get("q_gato") >= 3 then s = s .. " Num canto protegido do vento tem caixotes de madeira cheios de terra: é a horta da Dona Ishi. Do lado, um barraco de chapa com pombos." end
        return s
    end,
    exits = {
        { id = "escada", to = "corredor", label = "Descer a escada de incêndio", duration = 4 },
        { id = "pombal", to = "pombal", label = "Entrar no pombal", duration = 1, hidden = true }
    },
    actions = {
        falar("pixel"),
        falar("ishi"),
        { id = "olhar", label = "Ficar olhando a cidade (30 min)", duration = 30,
          execute = function(ctx)
              limpa()
              State.set("cansaco", math.max(0, State.get("cansaco") - 1))
              if Time.is_night() then
                  Narrator.say("Você conta as janelas acesas do prédio da frente e para em quarenta. Em três delas tem alguém de pé, de costas, olhando pra mesma coisa que você.")
                  Narrator.say("Lá embaixo, a avenida pisca em vermelho e roxo. Nenhum barulho chega até aqui em cima, só o zumbido das caixas d'água.")
              else
                  Narrator.say("Drones de entrega cruzam o céu em linha reta e vão ficando pequenos. Por vinte minutos você consegue não pensar na dívida. Depois lembra.")
              end
          end },
        { id = "horta", label = "Ajudar na horta (40 min)", duration = 40,
          conditions = function(ctx) return State.get("q_gato") >= 3 and State.get("horta_dia") ~= Time.day() end,
          scene = "horta_ishi" }
    }
})

Room.create("pombal", {
    title = "Pombal de Kenji",
    description = "Um barraco de chapa e madeira, do tamanho de um armário grande. Tem gaiolas empilhadas, pombos arrulhando e penas pelo chão. Numa bancada de solda, as ferramentas estão arrumadas por tamanho. Ao lado, um rádio de ondas curtas verde-militar e um caderno de capa dura preso com elástico.",
    exits = { { id = "telhado", to = "telhado", label = "Voltar ao telhado", duration = 1 } },
    actions = {
        { id = "radio", label = "Ouvir o rádio de Kenji (30 min)", duration = 30, scene = "radio_kenji" },
        { id = "caderno_kenji", label = "Ler o caderno de Kenji (20 min)", duration = 20, scene = "caderno_kenji" }
    }
})

Room.create("hall_bloco", {
    title = "Térreo do Bloco 14",
    description = "O piso de borracha está gasto, as caixas de correio estão amassadas, e o elevador tem uma placa: 'Lotação 4 (na prática: 9)'. Na parede, uma TV holográfica presa com quatro parafusos e um monte de fita. A portaria está vazia há meses, então o balcão virou apoio pra quem espera a chuva passar.",
    exits = {
        { id = "elevador", to = "corredor", label = "Subir pelo elevador", duration = 3 },
        { id = "rua", to = "rua_neon", label = "Sair para a Avenida Néon", duration = 2 },
        { id = "zeladoria", to = "zeladoria", label = "Entrar na zeladoria", duration = 1, hidden = true }
    },
    actions = {
        { id = "tv", label = "Assistir à TV do hall (5 min)", duration = 5, scene = "jornal" },
        { id = "atras_tv", label = "Olhar atrás da TV (5 min)", duration = 5, hidden = true,
          conditions = function() return not viu("atras_tv") end,
          execute = function(ctx)
              limpa()
              State.set("t_atras_tv", true)
              Narrator.say("Você puxa a TV pra longe da parede. Atrás dela tem uma porta de metal sem placa. A fechadura foi arrancada e remendada com arame.")
              Narrator.say("Alguém usa essa porta o tempo todo: o chão tem uma trilha limpa até ela.")
              Room.reveal("hall_bloco", "zeladoria")
              Room.reveal("hall_bloco", "atras_tv")
          end }
    }
})

Room.create("zeladoria", {
    title = "Zeladoria do Bloco 14",
    description = "Uma sala sem janela. Tem uma caldeira velha, ferramentas penduradas em cima de silhuetas pintadas na parede, um colchão de espuma no canto e uma caixa de isopor fechada. Cheira a ferrugem e a algo doce que gruda na garganta.",
    exits = { { id = "hall", to = "hall_bloco", label = "Voltar ao hall", duration = 1 } },
    actions = {
        { id = "isopor", label = "Abrir a caixa de isopor", duration = 3,
          conditions = function() return not viu("isopor_aberto") end,
          execute = function(ctx)
              limpa()
              State.set("t_isopor_aberto", true)
              State.add("lore_bruma", 1)
              Narrator.say("Ampolas de vidro azul-acinzentado, sem etiqueta, em fileiras de dez. Faltam quatro. Na tampa, alguém escreveu a lápis: 'Lote 9. Não repor.'")
              Narrator.say("Uma das ampolas quebrou e secou no fundo da caixa. O cheiro doce vem dela.")
          end },
        { id = "mochila", label = "Examinar a mochila térmica no colchão", duration = 3,
          conditions = function() return not viu("mochila_beto") end,
          execute = function(ctx)
              limpa()
              State.set("t_mochila_beto", true)
              Narrator.say("A mochila é amarela, com o gato do logotipo acenando e a frase: 'Lámen do Taro: quente em 15 minutos ou é de graça'.")
              Narrator.say("Lá dentro tem uma tampa de tigela amassada, um cartão de ponto assinado 'B.' e um bilhete dobrado: 'Taro, hoje eu volto. Juro.' Não tem data.")
          end }
    }
})

-- ---------- Avenida ----------

Room.create("rua_neon", {
    title = "Avenida Néon (quadra do Bloco 14)",
    description = function(ctx)
        local s = "A calçada é estreita e cheia de gente. Os letreiros brilham em kanji, em português e em código binário, e os camelôs vendem em mesinhas dobráveis. Motos magnéticas passam a vinte centímetros de quem anda distraído. O chão é uma crosta de chiclete e óleo. De um lado fica o Lámen do Taro, do outro, a feira de peças."
        if Time.is_night() then s = s .. " De noite, os letreiros parecem gritar uns com os outros, e quase ninguém para de andar." end
        if State.get("heat") >= 3 then s = s .. " Os drones da Helix estão voando mais baixo que o normal." end
        return s .. clima()
    end,
    exits = {
        { id = "bloco", to = "hall_bloco", label = "Entrar no Bloco 14", duration = 2 },
        { id = "noodle", to = "noodle_bar", label = "Entrar no Lámen do Taro", duration = 1 },
        { id = "feira", to = "feira", label = "Ir à feira de peças", duration = 2 },
        { id = "sul", to = "cruzamento", label = "Seguir a avenida para o sul", duration = 6 }
    },
    actions = {
        { id = "observar", label = "Parar e observar a avenida (10 min)", duration = 10, scene = "observar_rua" }
    }
})

Room.create("feira", {
    title = "Feira de peças",
    description = "Meia dúzia de barracas de lona em cima de caixotes. Tem placas de circuito empilhadas por cor, cabos enrolados em braços de manequim e olhos artificiais guardados em potes de vidro. Os camelôs conversam entre si e nem olham pra mercadoria.",
    exits = { { id = "rua", to = "rua_neon", label = "Voltar à avenida", duration = 2 } },
    actions = {
        falar("ishi"),
        { id = "conversar", label = "Conversar com os camelôs (15 min)", duration = 15, scene = "camelos" },
        { id = "feira", label = "Garimpar as barracas (20 min)", duration = 20,
          execute = function(ctx)
              limpa()
              local r = math.random(1, 10)
              if r >= 9 then
                  Narrator.say("No fundo de uma caixa de conectores, você acha um chip de crédito velho, com saldo. O dono da barraca está olhando pro outro lado e não pergunta nada.")
                  ganha(35)
              elseif r <= 2 then
                  Narrator.say("Um camelô tenta te vender um 'implante legítimo': um mouse enrolado em fita isolante com dois LEDs colados. Ele jura de pé junto que já salvou três vidas.")
              else
                  Narrator.say("Você revira fios por vinte minutos. Acha uma bateria que ainda segura carga e uma mão mecânica de criança. Nada que valha o preço.")
              end
          end }
    }
})

Room.create("noodle_bar", {
    title = "Lámen do Taro",
    description = function(ctx)
        local s = "O balcão tem seis banquetas parafusadas no chão. Panelas de aço do tamanho de pneus soltam vapor. Uma TV velha, pendurada no canto, passa propaganda sem parar. Sobre a porta, um holograma de gato acena ('Bem-vindo!'), tremendo, com o braço quebrado."
        if ativ("taro") == "dormindo" then s = s .. " A cortina de ferro está meio baixada e o balcão está apagado. Atrás do biombo, alguém ronca." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "rua_neon", label = "Sair para a avenida", duration = 1 },
        { id = "cozinha", to = "cozinha_taro", label = "Passar para a cozinha", duration = 1, hidden = true }
    },
    actions = {
        falar("taro"),
        falar("rex"),
        { id = "comer", label = "Pedir uma tigela de lámen", duration = 25,
          conditions = function(ctx)
              local custo = State.get("taro_amigo") and 8 or 15
              return ativ("taro") ~= "dormindo" and State.get("creditos") >= custo
          end,
          execute = function(ctx)
              limpa()
              local custo = State.get("taro_amigo") and 8 or 15
              State.subtract("creditos", custo)
              curar(15)
              Narrator.say("Taro bate a tigela no balcão e empurra os hashis na sua direção. O caldo está fervendo, o macarrão é quase de verdade e tem uma gema mole por cima. Você come sem falar nada. (-" .. custo .. " ¢, +15 saúde)")
          end },
        { id = "ajudar", label = "Ajudar na cozinha por uma hora", duration = 60,
          conditions = function(ctx)
              return ativ("taro") ~= "dormindo" and State.get("ajudou_dia") ~= Time.day() and State.get("met_taro")
          end,
          scene = "ajudar_taro" },
        { id = "tv_taro", label = "Assistir à TV do balcão (5 min)", duration = 5, scene = "jornal" }
    }
})

Room.create("cozinha_taro", {
    title = "Cozinha do Taro",
    description = "É uma cozinha de três metros quadrados. Tem um fogão de seis bocas, uma pia de aço com a torneira presa com arame e caixas de macarrão empilhadas até o teto. Na geladeira, um ímã de gato, e do lado, um calendário com os dias riscados a caneta. A porta dos fundos dá num beco. Cheira a alho queimado e a detergente.",
    exits = {
        { id = "balcao", to = "noodle_bar", label = "Voltar ao balcão", duration = 1 },
        { id = "fundos", to = "becos", label = "Sair pela porta dos fundos", duration = 2 }
    },
    actions = {
        falar("taro"),
        { id = "calendario", label = "Olhar o calendário", duration = 2,
          conditions = function() return not viu("calendario_taro") end,
          execute = function(ctx)
              limpa()
              State.set("t_calendario_taro", true)
              Narrator.say("Os dias estão riscados até uma data de dez dias atrás. Nesse dia, em vez de um X, alguém desenhou um círculo. Embaixo está escrito: 'Beto não veio.'")
              Narrator.say("Todos os dias depois desse têm um segundo risco, mais fraquinho. Parece que o Taro esperou, esperou e depois parou de esperar.")
          end }
    }
})

Room.create("cruzamento", {
    title = "Cruzamento do Sinapse",
    description = function(ctx)
        local s = "Quatro ruas se encontram debaixo de um telão que nunca desliga. Tem uma carrocinha de café sintético, um ponto de moto-táxi, uma escada que desce até o NetHaven e uma porta de luz roxa com a palavra SINAPSE. Ao norte ficam a Avenida Néon e o Bloco 14. Ao sul, a rua desce e fica mais escura."
        if State.get("heat") >= 3 then s = s .. " Tem um carro branco parado na esquina, com o motor ligado. Já faz muito tempo que ele está ali." end
        return s .. clima()
    end,
    exits = {
        { id = "norte", to = "rua_neon", label = "Voltar pela Avenida Néon", duration = 6 },
        { id = "bar", to = "bar_sinapse", label = "Entrar no Bar Sinapse", duration = 2 },
        { id = "nexus", to = "nexus", label = "Descer para o NetHaven", duration = 2 },
        { id = "sul", to = "av_baixa", label = "Descer pela Avenida Baixa", duration = 6 },
        { id = "fachadas", to = "fachadas", label = "Seguir pela Rua das Fachadas Brancas", duration = 12, hidden = true }
    },
    actions = {
        falar("mira"),
        { id = "telao", label = "Assistir ao telão (5 min)", duration = 5, scene = "jornal" }
    }
})

Room.create("bar_sinapse", {
    title = "Bar Sinapse",
    description = function(ctx)
        local s = "A luz é roxa. Os bancos de vinil estão rasgados, e o balcão é de aço. Atrás dele, o androide Bartô limpa o mesmo copo sem parar. Cheira a gelo derretido e a álcool de verdade, que aqui é raro e caro. A máquina de música toca sempre a mesma faixa, sem letra."
        if Time.is_night() then s = s .. " De noite, as mesas do fundo ficam cheias de gente que conversa sem mexer o rosto." end
        return s
    end,
    exits = { { id = "cruzamento", to = "cruzamento", label = "Sair para o cruzamento", duration = 2 } },
    actions = {
        falar("mira"),
        falar("lyra", 8),
        falar("sal"),
        { id = "beber", label = "Pedir um drink e ouvir as mesas (30 ¢)", duration = 30,
          conditions = function(ctx) return State.get("creditos") >= 30 end,
          scene = "boato" }
    }
})

Room.create("nexus", {
    title = "NetHaven (ciber-café)",
    description = "Fileiras de computadores velhos, com adesivos de gato e de caveira. Os ventiladores zumbem, o ar é quente, e todo mundo tem o rosto azulado pela tela e não olha pra ninguém. Na entrada tem uma placa: 'Sem comida nas máquinas. Sem desculpas também.'",
    exits = { { id = "rua", to = "cruzamento", label = "Subir para o cruzamento", duration = 2 } },
    actions = {
        falar("pixel"),
        falar("mira"),
        { id = "forum", label = "Ler os fóruns da rede (20 min)", duration = 20, scene = "forum_nexus" },
        { id = "anuncios", label = "Invadir a rede de anúncios (60 min)", duration = 60,
          conditions = function(ctx) return State.get("hacker") >= 1 end,
          scene = "hack_anuncios" },
        { id = "voz", label = "Abrir o terminal anônimo", duration = 10,
          conditions = function(ctx) return State.get("q_main") >= 3 end,
          scene = "voz_terminal" }
    }
})

Room.create("av_baixa", {
    title = "Avenida Baixa",
    description = function(ctx)
        local s = "A avenida desce em rampa. Os letreiros ficam mais espaçados, e os postes não têm lâmpada. As vitrines têm grade. À esquerda fica o letreiro verde de uma clínica. À direita, um galpão sem janela com a palavra RINHA pintada à mão. No fim da descida, o asfalto vira terra, e é onde começam as docas."
        if Time.is_night() then s = s .. " Tem gente sentada no meio-fio, parada, olhando pro mesmo ponto." end
        return s .. clima()
    end,
    exits = {
        { id = "norte", to = "cruzamento", label = "Subir para o cruzamento", duration = 6 },
        { id = "clinica", to = "clinica", label = "Entrar na clínica", duration = 3 },
        { id = "arena", to = "arena", label = "Entrar na Arena Rinha", duration = 4 },
        { id = "beco", to = "becos", label = "Entrar no beco entre os prédios", duration = 4, hidden = true },
        { id = "docas", to = "docas", label = "Descer até as docas", duration = 18 },
        { id = "mercado", to = "mercado_noturno", label = "Ir à praça do Mercado Noturno", duration = 4,
          conditions = function(ctx) return noite_mercado() ~= nil end }
    },
    actions = {
        { id = "observar", label = "Parar e observar a rua (10 min)", duration = 10, scene = "observar_baixa" }
    }
})

Room.create("clinica", {
    title = "Clínica do Doc Sal",
    description = function(ctx)
        local s = "Os azulejos são manchados e a maca é de couro rachado. Numa prateleira, órgãos em potes com gel. Cheira a antisséptico forte e a café requentado, e por baixo disso vem um doce enjoativo que sai de uma porta lá no fundo."
        return s
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Sair para a avenida", duration = 3 },
        { id = "ala", to = "ala_bruma", label = "Passar pela porta dos fundos", duration = 1, hidden = true }
    },
    actions = {
        falar("sal"),
        falar("rex"),
        { id = "tratamento", label = "Tratamento rápido (40 ¢)", duration = 30,
          conditions = function(ctx) return Character.room("sal") == ctx.room and State.get("saude") < 100 and State.get("creditos") >= 40 end,
          execute = function(ctx)
              limpa()
              State.subtract("creditos", 40)
              curar(60)
              Narrator.say("Sal costura, injeta e resmunga números o tempo todo. Você sente a agulha atravessando a pele em quatro pontos. Sai todo remendado e sem desconto. (-40 ¢, +60 saúde)")
          end }
    }
})

Room.create("ala_bruma", {
    title = "Ala dos fundos",
    description = "Tem quatro macas de lona, todas ocupadas. Baldes no meio, uma torneira pingando num tanque e as janelas pintadas de preto por dentro. Os pacientes olham pro teto. Um deles conta números em voz baixa e volta ao começo toda vez que erra.",
    exits = { { id = "clinica", to = "clinica", label = "Voltar para a clínica", duration = 1 } },
    actions = {
        { id = "ajudar", label = "Ajudar na ala (60 min)", duration = 60, scene = "ala_ajudar" },
        { id = "paciente", label = "Sentar ao lado de um paciente (20 min)", duration = 20, scene = "ala_paciente" }
    }
})

Room.create("arena", {
    title = "Arena Rinha",
    description = function(ctx)
        if arena_ativa() then
            return "Gritaria, suor e luz que pisca sem parar. Os apostadores se debruçam na grade com notas na mão. No ringue, dois lutadores tentam descobrir até onde o outro aguenta. Um painel em cima da entrada mostra os nomes dos lutadores da noite."
        end
        return "O galpão está vazio e cheira a ferro e a pomada de massagem. O ringue está limpo demais para um lugar onde ninguém é preso. Tem um saco de pancada, um banco de supino e um painel apagado, com nomes riscados."
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Sair para a avenida", duration = 4 },
        { id = "vestiario", to = "vestiario", label = "Passar pela porta do vestiário", duration = 1, hidden = true }
    },
    actions = {
        falar("rex"),
        falar("sal"),
        { id = "quadro", label = "Ler o painel de lutadores (5 min)", duration = 5, scene = "quadro_lutadores" },
        { id = "lutar", label = "Entrar no ringue (taxa 50 ¢)", duration = 40,
          conditions = function(ctx) return arena_ativa() and State.get("saude") > 40 and State.get("creditos") >= 50 end,
          scene = "arena_lutar" },
        { id = "apostar", label = "Apostar numa luta", duration = 20,
          conditions = function(ctx) return arena_ativa() and State.get("creditos") >= 50 end,
          scene = "arena_apostar" }
    }
})

Room.create("vestiario", {
    title = "Vestiário da arena",
    description = "Armários sem porta, um banco de madeira lascada e um espelho rachado remendado com fita. Na parede, vinte e três fotos pequenas presas com tachinha. Em onze delas, alguém desenhou um X com caneta vermelha.",
    exits = { { id = "arena", to = "arena", label = "Voltar à arena", duration = 1 } },
    actions = {
        falar("rex"),
        { id = "mural", label = "Olhar as fotos da parede (5 min)", duration = 5, scene = "mural_rex" }
    }
})

Room.create("mercado_noturno", {
    title = "Mercado Noturno",
    description = "As barracas são improvisadas, com toldos de plástico e lâmpadas coloridas ligadas em baterias de moto. Os vendedores gritam em três idiomas. Cheira a fritura, a ozônio e a dinheiro suado.",
    exits = { { id = "rua", to = "av_baixa", label = "Voltar à Avenida Baixa", duration = 4 } },
    actions = {
        falar("zeca"),
        { id = "passear", label = "Passear entre as bancas (20 min)", duration = 20, scene = "mercado_passeio" },
        { id = "chip", label = "Comprar o chip de memória da noite (80 ¢)", duration = 10,
          conditions = function(ctx)
              local n = noite_mercado()
              return n ~= nil and not State.get("chip_" .. n) and State.get("creditos") >= 80 and State.get("zeca_conf") >= 1
          end,
          execute = function(ctx)
              limpa()
              local n = noite_mercado()
              if not n then Narrator.say("A banca já sumiu.") return end
              State.set("chip_" .. n, true)
              State.subtract("creditos", 80)
              Inventory.give(CHIP[n], 1)
              Narrator.say("Uma mão sem rosto troca o chip por 80 ¢. 'Não use em público', diz uma voz. (Use pelo inventário.)")
          end }
    }
})

Room.create("becos", {
    title = "Becos do Distrito 9",
    description = function(ctx)
        local s = "Vielas entre prédios que quase se tocam. As poças refletem os letreiros lá longe, e ratos mecânicos roem fios na parede. Tem pichações de um olho riscado. Cheira a lixo e a alguma coisa doce."
        if State.get("heat") >= 4 then s = s .. " Tem pegadas novas de bota pesada na lama." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Voltar à Avenida Baixa", duration = 4 },
        { id = "docas", to = "docas", label = "Seguir o beco até as docas", duration = 10 },
        { id = "cozinha", to = "cozinha_taro", label = "Entrar pela porta dos fundos do lámen", duration = 2, hidden = true },
        { id = "bueiro", to = "refugio", label = "Descer pelo bueiro marcado", duration = 8, hidden = true }
    },
    actions = {
        falar("zeca"),
        falar("mira"),
        { id = "brumados", label = "Falar com as pessoas sentadas no chão (10 min)", duration = 10, scene = "bruma_beco" },
        { id = "gato", label = "Seguir o brilho azul (30 min)", duration = 30,
          conditions = function(ctx) return State.get("q_gato") == 1 and State.get("pista_gato") >= 1 end,
          scene = "gato_busca" },
        { id = "lixo", label = "Revistar lixeiras (20 min)", duration = 20,
          execute = function(ctx)
              limpa()
              local r = math.random(1, 10)
              if r >= 9 then Narrator.say("No meio de cascas e fios, você acha uma carteira vazia com um chip de crédito colado na costura.") ganha(20)
              elseif r <= 2 then Narrator.say("Uma agulha usada fura a sua luva.") State.subtract("saude", 3) Narrator.say("(-3 de saúde)")
              elseif r == 3 then Narrator.say("Embaixo de uma caixa tem uma ampola azul-acinzentada, vazia. Alguém lambeu até a última gota antes de jogar fora.") State.add("lore_bruma", 1)
              else Narrator.say("Só lixo. E cheiro de lixo.") end
          end }
    }
})

Room.create("docas", {
    title = "Docas abandonadas",
    description = function(ctx)
        local s = "Guindastes enferrujados, contêineres empilhados em torres tortas e um rio escuro que não reflete nada. No cais, um barco inteiro afundado, com só a antena pra fora."
        if Time.is_night() then s = s .. " De noite só se ouvem correntes batendo em ferro e passos que podem ser os seus." end
        return s .. clima()
    end,
    exits = {
        { id = "rua", to = "av_baixa", label = "Subir até a Avenida Baixa", duration = 18 },
        { id = "becos", to = "becos", label = "Voltar pelos becos", duration = 10 },
        { id = "conteineres", to = "conteineres_sul", label = "Ir aos contêineres do lado sul", duration = 5, hidden = true },
        { id = "armazem", to = "armazem_qi", label = "Entrar no armazém de Madame Qi", duration = 2, hidden = true }
    },
    actions = {
        falar("qi", 8),
        { id = "olhar", label = "Olhar o rio (10 min)", duration = 10, scene = "olhar_rio" },
        { id = "trabalho", label = "Fazer um trabalho sujo para Madame Qi (90 min)", duration = 90,
          conditions = function(ctx)
              return Character.room("qi") == ctx.room and State.get("divida") > 0 and State.get("qi_dia") ~= Time.day() and State.get("saude") > 30
          end,
          scene = "trabalho_qi" }
    }
})

Room.create("armazem_qi", {
    title = "Armazém de Madame Qi",
    description = "É um armazém de teto bem alto. No meio, uma mesa redonda com um bule de ferro, três xícaras, uma balança de precisão e um livro-caixa encapado em couro. Tem duas cadeiras pra quem deve e uma pra quem cobra. Perto da porta, dois homens de casaco comprido esperam sem olhar pra nada.",
    exits = { { id = "docas", to = "docas", label = "Sair para as docas", duration = 2 } },
    actions = {
        falar("qi", 8),
        { id = "livro", label = "Olhar o livro-caixa", duration = 5, scene = "livro_qi" },
        { id = "trabalho", label = "Fazer um trabalho sujo para Madame Qi (90 min)", duration = 90,
          conditions = function(ctx)
              return Character.room("qi") == ctx.room and State.get("divida") > 0 and State.get("qi_dia") ~= Time.day() and State.get("saude") > 30
          end,
          scene = "trabalho_qi" }
    }
})

Room.create("conteineres_sul", {
    title = "Contêineres do lado sul",
    description = "Um corredor de contêineres empilhados, com a tinta descascando e os números de série raspados. O chão tem poças de óleo e marcas de empilhadeira. Um dos contêineres está com a porta entreaberta há dias.",
    exits = { { id = "docas", to = "docas", label = "Voltar às docas", duration = 5 } },
