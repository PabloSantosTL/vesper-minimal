-- ---------- Torre Helix ----------

Room.create("fachadas", {
    title = "Rua das Fachadas Brancas",
    description = function(ctx)
        local s = "São prédios de escritórios com vitrines vazias. A calçada é lavada por drones, e tem uma câmera a cada seis metros. O Distrito 9 ficou pra trás. À sua frente está a Torre Helix, tão grande que não sobra espaço pro céu."
        if State.get("blackout") then s = s .. " Sem energia, as luzes das câmeras estão apagadas e os drones estão parados no chão." end
        return s
    end,
    exits = {
        { id = "cruzamento", to = "cruzamento", label = "Voltar ao cruzamento", duration = 12 },
        { id = "torre", to = "torre_helix", label = "Entrar no saguão da Torre", duration = 3 }
    },
    actions = {
        { id = "observar", label = "Observar a Torre do outro lado da rua (15 min)", duration = 15, scene = "observar_torre" }
    }
})

Room.create("torre_helix", {
    title = "Saguão da Torre Helix",
    description = function(ctx)
        local s = "O chão é de mármore preto e os lustres têm luz fria. No meio do saguão, um logotipo de dois metros gira no ar. Os seguranças de terno branco fingem que não te veem, mas veem."
        if State.get("blackout") then s = s .. " As luzes estão no modo de emergência, vermelhas e tremendo." end
        return s
    end,
    exits = {
        { id = "rua", to = "fachadas", label = "Sair da Torre", duration = 3 },
        { id = "elevador_lab", to = "laboratorio", label = "Entrar no elevador do laboratório", duration = 6, hidden = true }
    },
    actions = {
        falar("lyra", 8),
        { id = "cracha", label = "Mostrar o crachá falso ao segurança", duration = 10,
          conditions = function(ctx) return State.get("q_main") >= 3 and Inventory.has("cracha_falso") and not State.get("lab_aberto") end,
          scene = "lobby_cracha" },
        { id = "servico", label = "Entrar pela porta de serviço", duration = 15,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("blackout") and not State.get("lab_aberto") end,
          scene = "lobby_servico" },
        { id = "emp", label = "Detonar a granada de pulso EMP", duration = 5,
          conditions = function(ctx) return State.get("q_main") >= 3 and Inventory.has("pulso_emp") and not State.get("lab_aberto") end,
          scene = "lobby_emp" },
        { id = "painel", label = "Invadir o painel de acesso", duration = 30,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("hacker") >= 2 and not State.get("lab_aberto") end,
          scene = "lobby_hack" },
        { id = "voz_porta", label = "Pedir ajuda à Voz pelo comunicador", duration = 10,
          conditions = function(ctx) return State.get("q_main") >= 3 and State.get("vozes") >= 3 and not State.get("lab_aberto") end,
          scene = "lobby_voz" }
    }
})

Room.create("laboratorio", {
    title = "Laboratório Subnível 9 (ORFEU)",
